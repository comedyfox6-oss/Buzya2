"кисель\": [\"кисель\", \"крахмал\"],\n","    \"пектин\": [\"пектин\"],\n","    \"самбук\": [\"самбук\"],\n","    \"компот\": [\"компот\"],\n","    \"сладкие блюда\": [\"сладкие блюда\", \"десерты\"]\n","}\n","\n","def culinary_context(query, limit=3):\n","    with open(CULINARY_FILE, \"r\", encoding=\"utf-8\") as f:\n","        database = json.load(f)\n","\n","    query_lower = query.lower()\n","    matches = []\n","\n","    for entry in database[\"entries\"]:\n","        topic = entry[\"topic\"].lower()\n","        score = 0\n","\n","        if topic in query_lower:\n","            score += 100\n","\n","        for key, words in ALIASES.items():\n","            if key == topic:\n","                score += sum(\n","                    10 for word in words\n","                    if word in query_lower\n","                )\n","\n","        if score > 0:\n","            matches.append((score, entry))\n","\n","    matches.sort(key=lambda x: x[0], reverse=True)\n","\n","    if not matches:\n","        return \"В базе не найдено подходящей темы.\"\n","\n","    result = [\n","        \"ПРОВЕРЕННЫЕ МАТЕРИАЛЫ ИЗ КУЛИНАРНОЙ БАЗЫ:\",\n","        \"Не выдумывай сведения, которых нет в материалах.\"\n","    ]\n","\n","    for score, entry in matches[:limit]:\n","        result.append(\n","            \"\\nТЕМА: \" + entry[\"topic\"] +\n","            \"\\n\" + entry[\"definition\"]\n","        )\n","\n","        for key in [\"ingredients\", \"method\", \"quality\", \"important\"]:\n","            value = entry.get(key)\n","            if value:\n","                if isinstance(value, list):\n","                    value = \"; \".join(value)\n","                result.append(f\"{key.upper()}: {value}\")\n","\n","    return \"\\n\".join(result)\n","\n","\n","for question in [\n","    \"Как готовится мусс?\",\n","    \"Что используется в киселе?\",\n","    \"Что такое пектин?\",\n","    \"Что такое самбук?\"\n","]:\n","    print(\"\\nВОПРОС:\", question)\n","    print(culinary_context(question, limit=1))"],"metadata":{"id":"jWIjw_TcyWt2","executionInfo":{"status":"ok","timestamp":1794822999167,"user_tz":-180,"elapsed":86,"user":{"displayName":"Лаборатория","userId":"04378268399266155089"}},"outputId":"92adc754-8f8c-4343-df4e-ce6e2d496a7c","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","ВОПРОС: Как готовится мусс?\n","ПРОВЕРЕННЫЕ МАТЕРИАЛЫ ИЗ КУЛИНАРНОЙ БАЗЫ:\n","Не выдумывай сведения, которых нет в материалах.\n","\n","ТЕМА: Мусс\n","Мусс — сладкое взбитое блюдо с нежной, пористой и воздушной консистенцией.\n","INGREDIENTS: фруктово-ягодная основа или сок; сахар; желирующее вещество или манная крупа — в зависимости от рецептуры\n","METHOD: Подготовленную фруктовую основу соединяют с сахаром и предусмотренным рецептурой компонентом. Смесь охлаждают до начала загустевания и взбивают до образования пышной воздушной массы. Затем разливают по формам и охлаждают.\n","IMPORTANT: Технология зависит от рецептуры. Например, традиционный клюквенный мусс может готовиться с манной крупой.\n","\n","ВОПРОС: Что используется в киселе?\n","В базе не найдено подходящей темы.\n","\n","ВОПРОС: Что такое пектин?\n","ПРОВЕРЕННЫЕ МАТЕРИАЛЫ ИЗ КУЛИНАРНОЙ БАЗЫ:\n","Не выдумывай сведения, которых нет в материалах.\n","\n","ТЕМА: Пектин\n","Пектин — природный полисахарид растительного происхождения, который используют как желирующее и загущающее вещество.\n","IMPORTANT: Пектин применяют при приготовлении желе, мармелада и других продуктов. Основным загустителем традиционного киселя является крахмал.\n","\n","ВОПРОС: Что такое самбук?\n","ПРОВЕРЕННЫЕ МАТЕРИАЛЫ ИЗ КУЛИНАРНОЙ БАЗЫ:\n","Не выдумывай сведения, которых нет в материалах.\n","\n","ТЕМА: Самбук\n","Самбук — сладкое взбитое желированное блюдо, которое обычно готовят из фруктового или ягодного пюре, сахара и яичных белков с добавлением желатина.\n","METHOD: Фруктовое пюре соединяют с сахаром и взбитыми яичными белками. Затем вводят подготовленный желатин, разливают массу по формам и охлаждают.\n"]}]},{"cell_type":"code","source":["def normalize_word(word):\n","    word = word.lower().strip()\n","    endings = (\n","        \"ами\", \"ями\", \"ого\", \"его\", \"ому\", \"ему\",\n","        \"ыми\", \"ими\", \"ах\", \"ях\", \"ом\", \"ем\",\n","        \"ам\", \"ям\", \"ой\", \"ей\", \"ы\", \"и\", \"а\", \"я\", \"е\"\n","    )\n","\n","    for ending in endings:\n","        if len(word) > len(ending) + 3 and word.endswith(ending):\n","            return word[:-len(ending)]\n","\n","    return word\n","\n","\n","def culinary_context(query, limit=3):\n","    with open(CULINARY_FILE, \"r\", encoding=\"utf-8\") as f:\n","        database = json.load(f)\n","\n","    query_words = {\n","        normalize_word(w)\n","        for w in re.findall(r\"[а-яё]+\", query.lower())\n","    }\n","\n","    matches = []\n","\n","    for entry in database[\"entries\"]:\n","        topic_words = {\n","            normalize_word(w)\n","            for w in re.findall(\n","                r\"[а-яё]+\",\n","                entry[\"topic\"].lower()\n","            )\n","        }\n","\n","        score = len(query_words & topic_words)\n","\n","        if score:\n","            matches.append((score, entry))\n","\n","    matches.sort(key=lambda x: x[0], reverse=True)\n","\n","    if not matches:\n","        return \"В базе не найдено подходящей темы.\"\n","\n","    result = [\n","        \"ПРОВЕРЕННЫЕ МАТЕРИАЛЫ ИЗ КУЛИНАРНОЙ БАЗЫ:\",\n","        \"Не выдумывай сведения, которых нет в материалах.\"\n","    ]\n","\n","    for score, entry in matches[:limit]:\n","        result.append(\n","            \"\\nТЕМА: \" + entry[\"topic\"] +\n","            \"\\n\" + entry[\"definition\"]\n","        )\n","\n","        for key in [\"ingredients\", \"method\", \"quality\", \"important\"]:\n","            value = entry.get(key)\n","            if value:\n","                if isinstance(value, list):\n","                  